# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Specrew per-session files (F-051 multi-session foundation) - do not commit
.specrew/last-*
.specify/feature.json
.specrew/start-context.json
.specrew/host-history.json
.specrew/.cache/
.specrew/last-validator-summary.json
.specrew/active-sessions.yml
.specrew/workshop-visuals/
.agents/hooks.json

# Local-only: the handover quotes the human verbatim; runtime journals and local settings are per machine
.specrew/handover/
.specrew/runtime/
.claude/settings.local.json

# Node and build output
node_modules/
dist/
coverage/
reports/mutation/
test-results/
playwright-report/
*.log
*.tsbuildinfo

# Owner values and secrets never enter the repository
.env
.env.*
*.local.json

# The owner's own home scenarios stay local
bridge/test/scenarios/local/
